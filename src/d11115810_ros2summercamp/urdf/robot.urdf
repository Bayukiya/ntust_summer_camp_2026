<?xml version="1.0"?>
<robot name="manipulator_robot">

  <!-- Materials matching the colors in the picture -->
  <material name="red">
    <color rgba="0.8 0.0 0.0 1.0"/>
  </material>
  <material name="white">
    <color rgba="0.9 0.9 0.9 1.0"/>
  </material>
  <material name="yellow">
    <color rgba="0.8 0.8 0.0 1.0"/>
  </material>

  <!-- ==================== LINKS AND JOINTS ==================== -->

  <link name="base_link">
    <visual>
      <geometry><cylinder length="0.3" radius="0.15"/></geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry><cylinder length="0.3" radius="0.15"/></geometry>
    </collision>
  </link>

  <!-- arm_0_joint: Rotates around Z-axis -->
  <joint name="arm_0_joint" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10.0" velocity="1.0"/>
  </joint>

  <link name="link_1">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><cylinder length="0.1" radius="0.2"/></geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><cylinder length="0.1" radius="0.2"/></geometry>
    </collision>
  </link>

  <!-- arm_1_joint: Shoulder rotation -->
  <joint name="arm_1_joint" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10.0" velocity="1.0"/>
  </joint>

  <link name="link_2">
    <visual>
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
      <geometry><cylinder length="0.4" radius="0.1"/></geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
      <geometry><cylinder length="0.4" radius="0.1"/></geometry>
    </collision>
  </link>

  <!-- arm_2_joint: Elbow rotation -->
  <joint name="arm_2_joint" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0 0 0.4" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10.0" velocity="1.0"/>
  </joint>

  <link name="link_3">
    <visual>
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
      <geometry><cylinder length="0.4" radius="0.08"/></geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
      <geometry><cylinder length="0.4" radius="0.08"/></geometry>
    </collision>
  </link>

  <!-- ==================== GRIPPER SECTION ==================== -->

  <joint name="gripper_base_joint" type="fixed">
    <parent link="link_3"/>
    <child link="gripper_base"/>
    <origin xyz="0 0 0.4" rpy="0 0 0"/>
  </joint>

  <link name="gripper_base">
    <visual>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry><cylinder length="0.02" radius="0.15"/></geometry>
      <material name="yellow"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry><cylinder length="0.02" radius="0.15"/></geometry>
    </collision>
  </link>

  <!-- gripper_1_joint: Prismatic sliding jaw -->
  <joint name="gripper_1_joint" type="prismatic">
    <parent link="gripper_base"/>
    <child link="left_finger"/>
    <origin xyz="0 0.05 0.02" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.04" upper="0.0" effort="10.0" velocity="1.0"/>
  </joint>

  <link name="left_finger">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><box size="0.04 0.02 0.06"/></geometry>
      <material name="yellow"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><box size="0.04 0.02 0.06"/></geometry>
    </collision>
  </link>

  <!-- gripper_2_joint: Prismatic sliding jaw -->
  <joint name="gripper_2_joint" type="prismatic">
    <parent link="gripper_base"/>
    <child link="right_finger"/>
    <origin xyz="0 -0.05 0.02" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.04" effort="10.0" velocity="1.0"/>
  </joint>

  <link name="right_finger">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><box size="0.04 0.02 0.06"/></geometry>
      <material name="yellow"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><box size="0.04 0.02 0.06"/></geometry>
    </collision>
  </link>

</robot>
