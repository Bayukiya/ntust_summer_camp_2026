<?xml version="1.0"?>
<robot name="manipulator_robot">

  <!-- Materials matching color assignments -->
  <material name="red"><color rgba="0.8 0.0 0.0 1.0"/></material>
  <material name="white"><color rgba="0.9 0.9 0.9 1.0"/></material>
  <material name="yellow"><color rgba="0.8 0.8 0.0 1.0"/></material>

  <!-- ==================== LINKS AND JOINTS ==================== -->

  <!-- Base Link: Cylinder (h=0.3, r=0.15, m=2.0kg) -->
  <link name="base_link">
    <visual>
      <geometry><cylinder length="0.3" radius="0.15"/></geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry><cylinder length="0.3" radius="0.15"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.02625" ixy="0.0" ixz="0.0" iyy="0.02625" iyz="0.0" izz="0.0225"/>
    </inertial>
  </link>

  <!-- arm_0_joint -->
  <joint name="arm_0_joint" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10.0" velocity="1.0"/>
  </joint>

  <!-- Link 1: Cylinder (h=0.1, r=0.2, m=1.0kg) -->
  <link name="link_1">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><cylinder length="0.1" radius="0.2"/></geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><cylinder length="0.1" radius="0.2"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01083" ixy="0.0" ixz="0.0" iyy="0.01083" iyz="0.0" izz="0.02"/>
    </inertial>
  </link>

  <!-- arm_1_joint -->
  <joint name="arm_1_joint" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10.0" velocity="1.0"/>
  </joint>

  <!-- Link 2: Cylinder (h=0.4, r=0.1, m=1.0kg) -->
  <link name="link_2">
    <visual>
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
      <geometry><cylinder length="0.4" radius="0.1"/></geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
      <geometry><cylinder length="0.4" radius="0.1"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01583" ixy="0.0" ixz="0.0" iyy="0.01583" iyz="0.0" izz="0.005"/>
    </inertial>
  </link>

  <!-- arm_2_joint -->
  <joint name="arm_2_joint" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0 0 0.4" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10.0" velocity="1.0"/>
  </joint>

  <!-- Link 3: Cylinder (h=0.4, r=0.08, m=1.0kg) -->
  <link name="link_3">
    <visual>
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
      <geometry><cylinder length="0.4" radius="0.08"/></geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
      <geometry><cylinder length="0.4" radius="0.08"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.0148" ixy="0.0" ixz="0.0" iyy="0.0148" iyz="0.0" izz="0.0032"/>
    </inertial>
  </link>

  <!-- ==================== GRIPPER SECTION ==================== -->

  <!-- Fixed Joint to Gripper Base -->
  <joint name="gripper_base_joint" type="fixed">
    <parent link="link_3"/>
    <child link="gripper_base"/>
    <origin xyz="0 0 0.4" rpy="0 0 0"/>
  </joint>

  <!-- Gripper Base: Cylinder (h=0.02, r=0.15, m=0.5kg) -->
  <link name="gripper_base">
    <visual>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry><cylinder length="0.02" radius="0.15"/></geometry>
      <material name="yellow"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry><cylinder length="0.02" radius="0.15"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.00283" ixy="0.0" ixz="0.0" iyy="0.00283" iyz="0.0" izz="0.00563"/>
    </inertial>
  </link>

  <!-- gripper_1_joint -->
  <joint name="gripper_1_joint" type="prismatic">
    <parent link="gripper_base"/>
    <child link="left_finger"/>
    <origin xyz="0 0.05 0.02" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.04" upper="0.0" effort="10.0" velocity="1.0"/>
  </joint>

  <!-- Left Finger: Box (x=0.04, y=0.02, z=0.06, m=0.1kg) -->
  <link name="left_finger">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><box size="0.04 0.02 0.06"/></geometry>
      <material name="yellow"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><box size="0.04 0.02 0.06"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.000033" ixy="0.0" ixz="0.0" iyy="0.000043" iyz="0.0" izz="0.000017"/>
    </inertial>
  </link>

  <!-- gripper_2_joint -->
  <joint name="gripper_2_joint" type="prismatic">
    <parent link="gripper_base"/>
    <child link="right_finger"/>
    <origin xyz="0 -0.05 0.02" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.04" effort="10.0" velocity="1.0"/>
  </joint>

  <!-- Right Finger: Box (x=0.04, y=0.02, z=0.06, m=0.1kg) -->
  <link name="right_finger">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><box size="0.04 0.02 0.06"/></geometry>
      <material name="yellow"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><box size="0.04 0.02 0.06"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.000033" ixy="0.0" ixz="0.0" iyy="0.000043" iyz="0.0" izz="0.000017"/>
    </inertial>
  </link>

</robot>
